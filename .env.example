# ==========================================
# PatchForge Environment Variables
# ==========================================

# Nebius Token Factory (OpenAI-compatible)
# Sign up at: https://tokenfactory.nebius.com
# Use promo code NEBIUS-DEVPOST-GLOBAL26 for $25 credit
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# NVIDIA Nemotron Model IDs (Overrides dynamic resolution if set)
# Defaults will be resolved automatically from /v1/models:
# Tier 1: nvidia/nemotron-3-nano-30b-instruct
# Tier 2: nvidia/nemotron-3-super-120b-instruct
# Tier 3: nvidia/nemotron-3-ultra-550b-instruct
NEBIUS_MODEL_NANO=nvidia/nemotron-3-nano-30b-instruct
NEBIUS_MODEL_SUPER=nvidia/nemotron-3-super-120b-instruct
NEBIUS_MODEL_ULTRA=nvidia/nemotron-3-ultra-550b-instruct

# Tavily Live Search API (Mandatory for live CVE & migration doc grounding)
# Sign up at: https://tavily.com ($25 hackathon partner credit)
TAVILY_API_KEY=your_tavily_api_key_here

# LangSmith Tracing & Observability (Optional but recommended)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=patchforge

# Server & Sandbox Configuration
HOST=0.0.0.0
PORT=8000
SANDBOX_TIMEOUT_SECONDS=30
MAX_HEALING_RETRIES=3
CONFIDENCE_THRESHOLD_DOCS=0.90
CONFIDENCE_THRESHOLD_ULTRA=0.85
